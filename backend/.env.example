# Copy to .env and fill in values (or set via docker-compose environment)

DATABASE_URL=postgresql+asyncpg://ivdrive:CHANGE_ME@localhost:5432/ivdrive
VALKEY_URL=valkey://:CHANGE_ME@localhost:6379/0

JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
ENCRYPTION_KEY=CHANGE_ME_TO_BASE64_32_BYTE_KEY

CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=info

# When true, log each statistics/overview API request (route, params, result count) to container stdout (docker logs)
# STATISTICS_QUERY_DEBUG=true

# ─── Škoda Connect integration ────────────────────────────────
SKODA_BASE_URL=CHANGE_ME
SKODA_AUTH_CLIENT_ID=CHANGE_ME
SKODA_AUTH_REDIRECT_URI=CHANGE_ME

# ─── AI Assistant (chat LLM + RAG embeddings) ─────────────────
# Every provider is OPTIONAL: leave a line commented/empty and it is not used.
# Admin > AI Assistant > tier config picks provider + model per tier
# (provider = openai | anthropic | ollama | gemini | minimax).
#
# Any OpenAI-compatible server (OpenAI, LM Studio, vLLM, OpenRouter, Groq, LiteLLM ...):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Anthropic (or an Anthropic-compatible proxy via ANTHROPIC_BASE_URL):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Local models with Ollama (no key needed; from Docker use http://host.docker.internal:11434):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1
# Hosted extras:
# GEMINI_API_KEY=
# MINIMAX_API_KEY=
# LLM_TIMEOUT_SECONDS=60            # raise for slow local models
# LLM_FALLBACK_PROVIDERS=           # empty = any other configured provider, "none" = no fallback
#
# RAG embeddings (vectors are 768-dim): unset = Gemini if GEMINI_API_KEY is set, else an
# offline hash. Or use an OpenAI-compatible endpoint:  EMBEDDING_PROVIDER=ollama|openai
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=nomic-embed-text   # must output 768 dims (text-embedding-3-* are truncated to 768)
# EMBEDDING_BASE_URL=

# ─── RAG embedding worker (collector) ─────────────────────────
EMBEDDING_WORKER_ENABLED=true
EMBEDDING_WORKER_POLL_INTERVAL_SECONDS=300
EMBEDDING_WORKER_BATCH_SIZE=50
EMBEDDING_WORKER_MAX_ATTEMPTS=3

# ─── Object storage (conversation session backups) ────────────
USE_S3_STORAGE=true
CONVERSATION_SESSIONS_BUCKET=ivdrive-conversation-sessions
S3_ENDPOINT=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
