# iVDrive landing — static marketing + reverse proxy to ivdrive-web
{
	admin off
}

:80 {
	encode gzip

	# ── Docs site (Docusaurus) ──────────────────────────────────────────
	handle /docs/* {
		reverse_proxy ivdrive-docs:80 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /docs {
		redir /docs/ 308
	}

	# ── Marketing pages & assets ─────────────────────────────────────────
	@marketing path /features /features/* /features/ /open-source /open-source/* /open-source/ /community /community/* /community/ /about /about/* /about/ /roadmap /roadmap/* /roadmap/ /sponsors /sponsors/* /sponsors/ /sitemap.xml /robots.txt /og.png /brand/* /marketing/* /favicon.ico /_next/*
	handle @marketing {
		root * /srv
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
		}
	}

	# ── Root /: marketing vs app ────────────────────────────────────────
	handle / {
		@force_landing header_regexp Cookie `iv_view=landing`
		handle @force_landing {
			root * /srv
			try_files /index.html
			file_server
		}

		@bot header_regexp User-Agent `(?i)googlebot|bingbot|crawler|spider`
		handle @bot {
			root * /srv
			try_files /index.html
			file_server
		}

		@go_app header_regexp Cookie `access_token=|refresh_token=|iv_view=app`
		handle @go_app {
			reverse_proxy ivdrive-web:3000
		}

		@go_app_mobile header_regexp User-Agent `(?i)mobile|android|iphone|ipad|ipod|webos|blackberry|iemobile|opera mini|tablet`
		handle @go_app_mobile {
			reverse_proxy ivdrive-web:3000
		}

		handle {
			root * /srv
			try_files /index.html
			file_server
			header Cache-Control "public, max-age=3600"
		}
	}

	# ── Existing static files (RSC .txt, assets) ─────────────────────────
	@has_static file
	handle @has_static {
		root * /srv
		file_server
	}

	# ── Everything else → the real app ───────────────────────────────────
	handle {
		reverse_proxy ivdrive-web:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}
